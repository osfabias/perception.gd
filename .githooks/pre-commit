#!/usr/bin/env sh
set -eu

if [ -t 2 ]; then
  red=$(printf '\033[31m')
  bold=$(printf '\033[1m')
  reset=$(printf '\033[0m')
else
  red=''
  bold=''
  reset=''
fi

list=$(mktemp)
test_list=$(mktemp)
trap 'rm -f "$list" "$test_list"' EXIT

# Skip vendored addons, they are not formatted to this project's style.
# Tests intentionally call private virtual hooks, so private-access is disabled for them.
git diff --cached --name-only --diff-filter=ACMR -z -- '*.gd' \
  ':(exclude)addons/gut/**' ':(exclude)test/**' > "$list"
git diff --cached --name-only --diff-filter=ACMR -z -- 'test/*.gd' > "$test_list"

failed=0

if [ -s "$list" ] && ! xargs -0 -r gdscript-formatter lint --pretty < "$list"; then
  failed=1
fi

if [ -s "$test_list" ] \
  && ! xargs -0 -r gdscript-formatter lint --pretty --disable private-access < "$test_list"; then
  failed=1
fi

if [ "$failed" -ne 0 ]; then
  printf '\n%s%s✖  Lint errors found!%s Fix the issues above before committing.\n' "$bold" "$red" "$reset" >&2
  exit 1
fi

xargs -0 -r gdscript-formatter < "$list"
xargs -0 -r git add -- < "$list"
xargs -0 -r gdscript-formatter < "$test_list"
xargs -0 -r git add -- < "$test_list"

if ! godot --headless --path . -s addons/gut/gut_cmdln.gd; then
  printf '\n%s%s✖  Test failures found!%s Fix the failing tests above before committing.\n' "$bold" "$red" "$reset" >&2
  exit 1
fi
