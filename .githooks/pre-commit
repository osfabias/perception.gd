#!/usr/bin/env sh
set -eu

list=$(mktemp)
trap 'rm -f "$list"' EXIT

# Skip vendored addons, they are not formatted to this project's style.
git diff --cached --name-only --diff-filter=ACMR -z -- '*.gd' ':(exclude)addons/gut/**' > "$list"
[ -s "$list" ] || exit 0

if ! xargs -0 -r gdscript-formatter lint --pretty < "$list"; then
  if [ -t 2 ]; then
    red=$(printf '\033[31m')
    bold=$(printf '\033[1m')
    reset=$(printf '\033[0m')
  else
    red=''
    bold=''
    reset=''
  fi

  printf '\n%s%s✖  Lint errors found!%s Fix the issues above before committing.\n' "$bold" "$red" "$reset" >&2
  exit 1
fi

xargs -0 -r gdscript-formatter < "$list"
xargs -0 -r git add -- < "$list"
